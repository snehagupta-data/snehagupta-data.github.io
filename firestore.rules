rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      // Anyone (the contact form) can CREATE a message, with only the
      // 3 allowed fields, sensible lengths, and read=false.
      allow create: if request.auth == null
        && request.resource.data.keys().hasOnly(['name', 'subject', 'message', 'read', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.read == false;
      // Only Sneha, signed in to inbox.html, can read, mark read, or delete.
      allow read, update, delete: if request.auth != null;
    }
  }
}
